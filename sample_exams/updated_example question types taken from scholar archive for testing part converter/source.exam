cements\":[],\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true}],\"variables\":{\"drags_a\":{\"group\":\"Ungrouped variables\",\"name\":\"drags_a\",\"templateType\":\"list of strings\",\"description\":\"\",\"definition\":\"[ \\\"The sequence of bases can be determined for individual genes by using\\\", \\\"The use of computer technology to identify DNA sequences is known as\\\", \\\"An understanding of the genetic component of the risk of disease is required for\\\" ]\"}},\"variable_groups\":[],\"statement\":\"<p>Complete the sentences by dragging and dropping.</p>\",\"ungrouped_variables\":[\"drags_a\"],\"variablesTest\":{\"condition\":\"\",\"maxRuns\":100}},{\"name\":\"Slow and fast twitch muscle fibres\",\"extensions\":[\"manual_marking\"],\"custom_part_types\":[],\"resources\":[],\"navigation\":{\"showfrontpage\":false,\"allowregen\":true,\"preventleave\":false},\"contributors\":[{\"name\":\"Oormi Khaled\",\"profile_url\":\"https://numbas.mathcentre.ac.uk/accounts/profile/985/\"},{\"name\":\"Daniel Pacey\",\"profile_url\":\"https://assess12test.scholar.hw.ac.uk/accounts/profile/3/\"}],\"rulesets\":{},\"variablesTest\":{\"maxRuns\":100,\"condition\":\"\"},\"tags\":[\"colour\",\"fast twitch\",\"hg_chbi1_9etq3\",\"muscle fibre\",\"slow twitch\"],\"functions\":{},\"variables\":{},\"ungrouped_variables\":[],\"metadata\":{\"description\":\"<p>hg_chbi1_9etq3&nbsp;(previously hg_chbi1_12etq4v1)</p>\",\"licence\":\"All rights reserved\"},\"parts\":[{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\" Slow twitch fibres are dark red because they have a high concentration of myoglobin which stores oxygen for aerobic respiration. Fast twitch fibres are pale pink because they contain low concentrations of myoglobin as they mainly rely on anaerobic form of respiration (creatine phosphate and lactic acid metabolism).\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":\"6\",\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>Explain the difference between the colour of slow and fast twitch muscle fibres.</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('a')}{manualmarking_textarea_width('500px')}{manualmarking_render()}</p>\",\"marks\":0}],\"statement\":\"\",\"preamble\":{\"js\":\"\",\"css\":\"\"},\"variable_groups\":[],\"advice\":\"\"},{\"name\":\"Menstrual cycle 2\",\"extensions\":[\"manual_marking\"],\"custom_part_types\":[],\"resources\":[\"question-resources/hg-chbi2-2etq6-menstrualCycle_9tnNfnB.png\"],\"navigation\":{\"showfrontpage\":false,\"allowregen\":true,\"preventleave\":false},\"contributors\":[{\"name\":\"Oormi Khaled\",\"profile_url\":\"https://numbas.mathcentre.ac.uk/accounts/profile/985/\"},{\"name\":\"Daniel Pacey\",\"profile_url\":\"https://assess12test.scholar.hw.ac.uk/accounts/profile/3/\"}],\"rulesets\":{},\"variablesTest\":{\"maxRuns\":100,\"condition\":\"\"},\"tags\":[\"blastocyst\",\"hg_chbi2_2etq7\",\"hormone\",\"menstrual cycle\",\"ovulation\"],\"functions\":{},\"variables\":{},\"ungrouped_variables\":[],\"metadata\":{\"description\":\"<p><span data-sheets-value=\\\"{&quot;1&quot;:2,&quot;2&quot;:&quot;hg_chbi2_2et&quot;}\\\">hg_chbi2_2etq7&nbsp;(previously hg_chbi2_2etq6)</span></p>\",\"licence\":\"All rights reserved\"},\"parts\":[{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\"The high concentration of oestrogen (hormone A)  stimulates the pituitary to release a high concentration of LH which stimulates ovulation.\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":1,\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>What causes ovulation?</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('a')}{manualmarking_textarea_width('300px')}{manualmarking_render()}</p>\",\"marks\":0},{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\"Description:  concentration increases from days 1 to 4, then falls from days 5 to 12. Explanation: the pituitary releases an increasing concentration of FSH on days 1 to 4; the increase from day 1 to 4 is  caused by a low level of oestrogen/A;  the decrease from day 5 to 12 is caused by an  increase in secretion of oestrogen/A; which causes a reduction in the secretion of FSH/C.\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":\"3\",\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>Describe and explain the change in concentration of hormone C during the first 12 days of the cycle.</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('b')}{manualmarking_textarea_width('500px')}{manualmarking_render()}</p>\",\"marks\":0},{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\"High levels of progesterone have a negative feedback effect on the pituitary gland, resulting in the inhibition of FSH and LH.\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":1,\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>What is the effect of the high level of hormone B between days 18 to 26?</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('c')}{manualmarking_textarea_width('300px')}{manualmarking_render()}</p>\",\"marks\":0},{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\"Hormone B is progesterone which promotes the further proliferation of the endometrium.\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":1,\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>In what way does hormone B contribute to the survival of the blastocyst?</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('d')}{manualmarking_textarea_width('300px')}{manualmarking_render()}</p>\",\"marks\":0},{\"type\":\"gapfill\",\"sortAnswers\":false,\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"gaps\":[{\"type\":\"patternmatch\",\"matchMode\":\"exact\",\"unitTests\":[],\"showFeedbackIcon\":true,\"showCorrectAnswer\":true,\"fixedHeight\":\"0px\",\"displayAnswer\":\"Hormone B is progesterone released by the corpus luteum. The corpus luteum is only present after ovulation. The corpus luteum grows from days 16 to 22 and degenerates from days 23 to 28. This is caused by an increase then decrease in secretion of LH by pituitary.\",\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"variableReplacementStrategy\":\"originalfirst\",\"marks\":\"4\",\"scripts\":{},\"answer\":\"\",\"fixedWidth\":\"0px\"}],\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"extendBaseMarkingAlgorithm\":true,\"variableReplacements\":[],\"customMarkingAlgorithm\":\"\",\"prompt\":\"<p>Explain the changes in the concentration of hormone B during the cycle.</p>\\n<p>[[0]]</p>\\n<p>{manualmarking_builder('e')}{manualmarking_textarea_width('500px')}{manualmarking_render()}</p>\",\"marks\":0}],\"statement\":\"<p>The following graphs show the changes in concentration of four hormones in a woman's blood during one menstrual cycle.</p>\\n<p><img src=\\\"resources/question-resources/hg-chbi2-2etq6-menstrualCycle_9tnNfnB.png\\\" alt=\\\"Graph of concentration versus days for four hormones A, B, C and D.\\\"/></p>\",\"preamble\":{\"js\":\"\",\"css\":\"\"},\"variable_groups\":[],\"advice\":\"\"},{\"name\":\"Ion-electron equation\",\"extensions\":[],\"custom_part_types\":[],\"resources\":[],\"navigation\":{\"preventleave\":false,\"allowregen\":true,\"showfrontpage\":false},\"contributors\":[{\"name\":\"Oormi Khaled\",\"profile_url\":\"https://numbas.mathcentre.ac.uk/accounts/profile/985/\"},{\"name\":\"Daniel Pacey\",\"profile_url\":\"https://assess12test.scholar.hw.ac.uk/accounts/profile/3/\"}],\"functions\":{},\"ungrouped_variables\":[\"scholar_reveal_e\"],\"statement\":\"<p>Look at the following incomplete ion-electron equation.</p>\\n<p style=\\\"text-align: center;\\\">XeO<sub>3</sub> &rarr; Xe</p>\",\"tags\":[\"balance\",\"charge\",\"electron\",\"hg_cche1_6etq12\",\"hydrogen\",\"ion\",\"ion-electron equation\",\"molecule\",\"product\",\"reactant\",\"water\"],\"rulesets\":{},\"variables\":{\"scholar_reveal_e\":{\"name\":\"scholar_reveal_e\",\"templateType\":\"anything\",\"definition\":\"true\",\"group\":\"Ungrouped variables\",\"description\":\"\"}},\"variable_groups\":[],\"metadata\":{\"description\":\"<p>hg_cche1_6etq12</p>\",\"licence\":\"All rights reserved\"},\"variablesTest\":{\"maxRuns\":100,\"condition\":\"\"},\"parts\":[{\"extendBaseMarkingAlgorithm\":true,\"scripts\":{},\"showCorrectAnswer\":true,\"variableReplacementStrategy\":\"originalfirst\",\"unitTests\":[],\"prompt\":\"<p>How many water molecules have to be added to the product side?</p>\",\"matchMode\":\"regex\",\"fixedWidth\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showFeedbackIcon\":true,\"displayAnswer\":\"3\",\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"marks\":1,\"answer\":\".*(3|three).*\",\"type\":\"patternmatch\"},{\"extendBaseMarkingAlgorithm\":true,\"scripts\":{},\"showCorrectAnswer\":true,\"variableReplacementStrategy\":\"originalfirst\",\"unitTests\":[],\"prompt\":\"<p>How many hydrogen ions have to be added to the reactant side?</p>\",\"matchMode\":\"regex\",\"fixedWidth\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showFeedbackIcon\":true,\"displayAnswer\":\"6\",\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"marks\":1,\"answer\":\".*(6|six).*\",\"type\":\"patternmatch\"},{\"extendBaseMarkingAlgorithm\":true,\"scripts\":{},\"showCorrectAnswer\":true,\"variableReplacementStrategy\":\"originalfirst\",\"unitTests\":[],\"prompt\":\"<p>How many electrons have to be added to balance the charge?</p>\",\"matchMode\":\"regex\",\"fixedWidth\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showFeedbackIcon\":true,\"displayAnswer\":\"6\",\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"marks\":1,\"answer\":\".*(6|six).*\",\"type\":\"patternmatch\"},{\"maxMarks\":0,\"choices\":[\"Reactant\",\"Product\"],\"variableReplacements\":[],\"extendBaseMarkingAlgorithm\":true,\"showFeedbackIcon\":true,\"distractors\":[\"\",\"\"],\"showCorrectAnswer\":true,\"minMarks\":0,\"prompt\":\"<p>On which side do the electrons get added?</p>\",\"unitTests\":[],\"shuffleChoices\":false,\"customMarkingAlgorithm\":\"\",\"type\":\"1_n_2\",\"variableReplacementStrategy\":\"originalfirst\",\"scripts\":{},\"displayType\":\"radiogroup\",\"marks\":0,\"displayColumns\":\"1\",\"matrix\":[\"1\",0]},{\"extendBaseMarkingAlgorithm\":true,\"gaps\":[{\"maxMarks\":0,\"choices\":[\"an oxidation.\",\"a reduction\"],\"extendBaseMarkingAlgorithm\":true,\"scripts\":{},\"distractors\":[\"\",\"\"],\"matrix\":[0,\"1\"],\"showCorrectAnswer\":true,\"minMarks\":0,\"unitTests\":[],\"shuffleChoices\":true,\"customMarkingAlgorithm\":\"\",\"showFeedbackIcon\":true,\"variableReplacementStrategy\":\"originalfirst\",\"variableReplacements\":[],\"displayType\":\"dropdownlist\",\"marks\":0,\"displayColumns\":0,\"type\":\"1_n_2\"}],\"showCorrectAnswer\":true,\"variableReplacementStrategy\":\"originalfirst\",\"sortAnswers\":false,\"prompt\":\"<p>The completed ion-electron equation is&nbsp;[[0]]</p>\",\"marks\":0,\"customMarkingAlgorithm\":\"\",\"showFeedbackIcon\":true,\"variableReplacements\":[],\"unitTests\":[],\"scripts\":{},\"type\":\"gapfill\"}],\"preamble\":{\"css\":\"\",\"js\":\"\"},\"advice\":\"\"},{\"name\":\"Precedence tables and network diagrams\",\"extensions\":[\"drag_and_drop\"],\"custom_part_types\":[],\"resources\":[],\"navigation\":{\"allowregen\":true,\"showfrontpage\":false,\"preventleave\":false},\"contributors\":[{\"name\":\"Oormi Khaled\",\"profile_url\":\"https://numbas.mathcentre.ac.uk/accounts/profile/985/\"},{\"name\":\"Mandy Tait\",\"profile_url\":\"https://assess12test.scholar.hw.ac.uk/accounts/profile/15/\"}],\"tags\":[\"critical path\",\"n5_app4_0euq6\",\"network diagrams\",\"precedence tables\"],\"rulesets\":{},\"variablesTest\":{\"condition\":\"\",\"maxRuns\":100},\"ungrouped_variables\":[\"time_A\",\"time_B\",\"time_C\",\"time_D\",\"time_E\",\"time_F\",\"time_G\",\"time_H\",\"time_I\",\"time_J\",\"time_K\",\"total_mark_for_whole_part_a\",\"drags_a\"],\"variables\":{\"noncriticalpath1\":{\"name\":\"noncriticalpath1\",\"definition\":\"time_A + time_F + time_B + time_H + time_G + time_I + time_E + time_J\",\"group\":\"part b\",\"description\":\"\",\"templateType\":\"anything\"},\"time_C\":{\"name\":\"time_C\",\"definition\":\"random(15..17)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>15</p>\",\"templateType\":\"anything\"},\"time_D\":{\"name\":\"time_D\",\"definition\":\"random(18..22)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>20</p>\",\"templateType\":\"anything\"},\"time_F\":{\"name\":\"time_F\",\"definition\":\"random(2..3)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>3</p>\",\"templateType\":\"anything\"},\"time_G\":{\"name\":\"time_G\",\"definition\":\"random(4..6)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>5</p>\",\"templateType\":\"anything\"},\"noncriticalpath2\":{\"name\":\"noncriticalpath2\",\"definition\":\"time_A + time_F + time_B + time_H + time_G + time_C + time_E + time_J\",\"group\":\"part b\",\"description\":\"\",\"templateType\":\"anything\"},\"m1\":{\"name\":\"m1\",\"definition\":\"if(criticalpath>expectedtime,1,0)\",\"group\":\"part b\",\"description\":\"<p>The critical path has to be less than the expected time for the answer to be Yes to multiple choice question.</p>\",\"templateType\":\"anything\"},\"marks\":{\"name\":\"marks\",\"definition\":\"[m1,1-m1]\",\"group\":\"part b\",\"description\":\"\",\"templateType\":\"anything\"},\"noncriticalpath3\":{\"name\":\"noncriticalpath3\",\"definition\":\"time_A + time_F + time_K + time_D + time_G + time_I + time_E + time_J\",\"group\":\"part b\",\"description\":\"\",\"templateType\":\"anything\"},\"time_I\":{\"name\":\"time_I\",\"definition\":\"random(12..14)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>14</p>\",\"templateType\":\"anything\"},\"time_B\":{\"name\":\"time_B\",\"definition\":\"random(13..15)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>13</p>\",\"templateType\":\"anything\"},\"time_A\":{\"name\":\"time_A\",\"definition\":\"random(1..2)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>2</p>\",\"templateType\":\"anything\"},\"time_K\":{\"name\":\"time_K\",\"definition\":\"random(26..29) - time_D\",\"group\":\"Ungrouped variables\",\"description\":\"<p>7</p>\",\"templateType\":\"anything\"},\"criticalpath\":{\"name\":\"criticalpath\",\"definition\":\"time_A + time_F + time_K + time_D + time_G + time_C + time_E + time_J\",\"group\":\"part b\",\"description\":\"\",\"templateType\":\"anything\"},\"total_mark_for_whole_part_a\":{\"name\":\"total_mark_for_whole_part_a\",\"definition\":\"2\",\"group\":\"Ungrouped variables\",\"description\":\"\",\"templateType\":\"anything\"},\"time_E\":{\"name\":\"time_E\",\"definition\":\"random(2..3)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>3</p>\",\"templateType\":\"anything\"},\"expectedtime\":{\"name\":\"expectedtime\",\"definition\":\"random(55..60)\",\"group\":\"part b\",\"description\":\"<p>55</p>\",\"templateType\":\"anything\"},\"drags_a\":{\"name\":\"drags_a\",\"definition\":\"[\\\"A\\\",\\\"F\\\",\\\"B\\\",\\\"K\\\",\\\"D\\\",\\\"G\\\",\\\"C\\\",\\\"I\\\",\\\"E\\\",\\\"J\\\"]\",\"group\":\"Ungrouped variables\",\"description\":\"\",\"templateType\":\"anything\"},\"time_J\":{\"name\":\"time_J\",\"definition\":\"random(1..2)\",\"group\":\"Ungrouped variables\",\"description\":\"<p>2</p>\",\"templateType\":\"anything\"},\"time_H\":{\"name\":\"time_H\",\"definition\":\"random(23..25) - time_B\",\"group\":\"Ungrouped variables\",\"description\":\"<p>12</p>\",\"templateType\":\"anything\"}},\"metadata\":{\"licence\":\"All rights reserved\",\"description\":\"<p>n5_app4_0euq6</p>\"},\"advice\":\"<p><em>Working</em></p>\\n<p>b)</p>\\n<p>The times in&nbsp;minutes are shown below each task.</p>\\n<div id=\\\"relativeDiv\\\" style=\\\"width: 512px; height: 242px; border: 1px solid #000000; position: relative; max-width: 100%;\\\"><span class=\\\"absgf\\\" id=\\\"absgf0\\\" style=\\\"top: 118px; left: 26px; position: absolute;\\\">{time_A}</span> <span class=\\\"absgf\\\" id=\\\"absgf1\\\" style=\\\"top: 118px; left: 81px; position: absolute;\\\">{time_F}</span> <span class=\\\"absgf\\\" id=\\\"absgf2\\\" style=\\\"top: 68px; left: 148px; position: absolute;\\\">{time_B}</span> <span class=\\\"absgf\\\" id=\\\"absgf3\\\" style=\\\"top: 175px; left: 148px; position: absolute;\\\">{time_K}</span> <span class=\\\"absgf\\\" id=\\\"absgf4\\\" style=\\\"top: 68px; left: 208px; position: absolute;\\\">{time_H}</span> <span class=\\\"absgf\\\" id=\\\"absgf5\\\" style=\\\"top: 175px; left: 208px; position: absolute;\\\">{time_D}</span> <span class=\\\"absgf\\\" id=\\\"absgf6\\\" style=\\\"top: 118px; left: 275px; position: absolute;\\\">{time_G}</span> <span class=\\\"absgf\\\" id=\\\"absgf7\\\" style=\\\"top: 68px; left: 341px; position: absolute;\\\">{time_C}</span> <span class=\\\"absgf\\\" id=\\\"absgf8\\\" style=\\\"top: 175px; left: 341px; position: absolute;\\\">{time_I}</span> <span class=\\\"absgf\\\" id=\\\"absgf9\\\" style=\\\"top: 118px; left: 410px; position: absolute;\\\">{time_E}</span> <span class=\\\"absgf\\\" id=\\\"absgf10\\\" style=\\\"top: 118px; left: 465px; position: absolute;\\\">{time_J}</span> <img src=\\\"resources/question-resources/n5-app4-0-euq6networkdiagramanswer2.png\\\" alt=\\\"network diagram with times added for each of the 11 tasks and critical path shown\\\"/></div>\\n<p>You can see from the diagram that the route with the longest time follows the path: A, F, K, D, G, C, E, J so this is our critical path.</p>\\n<p>Critical path = {time_A} + {time_F} + {time_K} + {time_D} + {time_G} + {time_C} + {time_E} + {time_J} = {criticalpath} minutes.</p>\\n<p>The other routes are:</p>\\n<p>A, F, B, H, G, I, E, J has a total time of {noncriticalpath1} minutes.</p>\\n<p>A, F, B, H, G, C, E, J has a total time of {noncriticalpath2} minutes.</p>\\n<p>A, F, K, D, G, I, E, J has a total time of {noncriticalpath3} minutes.</p>\\n<p>We need to take the longer route to allow time for tasks H and D to all be completed before we can start task G, and tasks C and I to be completed before we can start task E.</p>\\n<p><strong>Answer:</strong> {criticalpath} minutes.</p>\\n<p><span data-jme-visible=\\\"m1 = 0\\\">Yes they are correct, it would take {criticalpath} minutes which is&nbsp;within the expected {expectedtime} minutes.</span></p>\\n<p><span data-jme-visible=\\\"m1 = 1\\\">No, they are not correct, it would take {criticalpath} minutes which is longer than the expected {expectedtime} minutes.</span></p>\",\"functions\":{},\"variable_groups\":[{\"variables\":[\"criticalpath\",\"noncriticalpath1\",\"noncriticalpath2\",\"noncriticalpath3\",\"expectedtime\",\"m1\",\"marks\"],\"name\":\"part b\"}],\"statement\":\"<p>Two siblings decide to wash and clean their parents' car before they go on holiday. The list of tasks required to wash and clean the car is detailed in the following table:</p>\\n<table border=\\\"1\\\" cellpadding=\\\"3\\\" cellspacing=\\\"1\\\" style=\\\"float: left;\\\">\\n<tbody>\\n<tr>\\n<th>Task</th>\\n<th>Description</th>\\n<th>Preceding task</th>\\n<th>Time (minutes)</th>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">A</td>\\n<td>Collect equipment</td>\\n<td style=\\\"text-align: center;\\\">None</td>\\n<td style=\\\"text-align: center;\\\">{time_A}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">B</td>\\n<td>Wash outside of car</td>\\n<td style=\\\"text-align: center;\\\">F</td>\\n<td style=\\\"text-align: center;\\\">{time_B}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">C</td>\\n<td>Polish outside of car</td>\\n<td style=\\\"text-align: center;\\\">G</td>\\n<td style=\\\"text-align: center;\\\">{time_C}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">D</td>\\n<td>Clean inside of windows</td>\\n<td style=\\\"text-align: center;\\\">K</td>\\n<td style=\\\"text-align: center;\\\">{time_D}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">E</td>\\n<td>Rinse buckets</td>\\n<td style=\\\"text-align: center;\\\">C / I</td>\\n<td style=\\\"text-align: center;\\\">{time_E}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">F</td>\\n<td>Fill buckets with water and soap</td>\\n<td style=\\\"text-align: center;\\\">A</td>\\n<td style=\\\"text-align: center;\\\">{time_F}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">G</td>\\n<td>Rinse outside of car</td>\\n<td style=\\\"text-align: center;\\\">H / D</td>\\n<td style=\\\"text-align: center;\\\">{time_G}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">H</td>\\n<td>Wash wheels</td>\\n<td style=\\\"text-align: center;\\\">B</td>\\n<td style=\\\"text-align: center;\\\">{time_H}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">I</td>\\n<td>Vacuum inside of car</td>\\n<td style=\\\"text-align: center;\\\">G</td>\\n<td style=\\\"text-align: center;\\\">{time_I}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">J</td>\\n<td>Return equipment</td>\\n<td style=\\\"text-align: center;\\\">E</td>\\n<td style=\\\"text-align: center;\\\">{time_J}</td>\\n</tr>\\n<tr>\\n<td style=\\\"text-align: center;\\\">K</td>\\n<td>Dust inside of car</td>\\n<td style=\\\"text-align: center;\\\">F</td>\\n<td style=\\\"text-align: center;\\\">{time_K}</td>\\n</tr>\\n</tbody>\\n</table>\",\"preamble\":{\"js\":\"\",\"css\":\"\"},\"parts\":[{\"unitTests\":[],\"type\":\"gapfill\",\"showFeedbackIcon\":true,\"sortAnswers\":false,\"marks\":0,\"stepsPenalty\":0,\"steps\":[{\"variableReplacements\":[],\"type\":\"information\",\"unitTests\":[],\"showCorrectAnswer\":true,\"prompt\":\"<p>Use the preceding task column to help you put the tasks in the correct order:</p>\\n<ul>\\n<li>Find the task that has no preceding task, this goes in box 1.</li>\\n<li>The task in box 7 must have 2 preceding tasks.</li>\\n<li>The task in box 10 must have 2 preceding tasks.</li>\\n<li>Box 2 must be filled by a task that follows on from the task in box 1. Repeat this process with the remaining tasks.</li>\\n</ul>\",\"showFeedbackIcon\":true,\"variableReplacementStrategy\":\"originalfirst\",\"marks\":0,\"customMarkingAlgorithm\":\"\",\"extendBaseMarkingAlgorithm\":true,\"scripts\":{}}],\"prompt\":\"<p>Using the information given in the precedence table complete the network diagram, by putting the letters into place in the correct order.</p>\\n<div id=\\\"relativeDiv\\\" style=\\\"width: 512px; height: 197px; border: 1px solid #000000; position: relative; max-width: 100%;\\\"><span class=\\\"absgf\\\" id=\\\"absgf0\\\" style=\\\"top: 90px; left: 26px; position: absolute;\\\">[[0]]</span> <span class=\\\"absgf\\\" id=\\\"absgf1\\\" style=\\\"top: 90px; left: 81px; position: absolute;\\\">[[1]]</span> <span class=\\\"absgf\\\" id=\\\"absgf2\\\" style=\\\"top: 40px; left: 148px; position: absolute;\\\">[[2]]</span> <span class=\\\"absgf\\\" id=\\\"absgf3\\\" style=\\\"top: 147px; left: 148px; position: absolute;\\\">[[3]]</span> <span class=\\\"absgf\\\" id=\\\"absgf5\\\" style=\\\"top: 147px; left: 208px; position: absolute;\\\">[[4]]</span> <span class=\\\"absgf\\\" id=\\\"absgf6\\\" style=\\\"top: 90px; left: 275px; position: absolute;\\\">[[5]]</span> <span class=\\\"absgf\\\" id=\\\"absgf7\\\" style=\\\"top: 40px; left: 341px; position: absolute;\\\">[[6]]</span> <span class=\\\"absgf\\\" id=\\\"absgf8\\\" style=\\\"top: 147px; left: 341px; position: absolute;\\\">[[7]]</span> <span class=\\\"absgf\\\" id=\\\"absgf9\\\" style=\\\"top: 90px; left: 410px; position: absolute;\\\">[[8]]</span> <span class=\\\"absgf\\\" id=\\\"absgf10\\\" style=\\\"top: 90px; left: 465px; position: absolute;\\\">[[9]]</span> <img src=\\\"resources/question-resources/n5-app4-0-euq6networkdiagram_5rf3AhZ.png\\\" alt=\\\"blank network diagram with 11 tasks and task h in box 5\\\"/></div>\\n<p>{dnd_builder(\\\"a\\\",\\\"text\\\",drags_a)}{dnd_dragHeight(25)}{dnd_dragWidth(20)}{dnd_render()}</p>\",\"scripts\":{},\"variableReplacements\":[],\"showCorrectAnswer\":true,\"gaps\":[{\"displayAnswer\":\"{drags_a[0]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[0]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[1]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[1]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[2]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[2]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[3]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[3]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[4]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[4]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[5]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[5]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[6]}\",\"unitTests\":[],\"matchMode\":\"regex\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"({drags_a[6]}|{drags_a[7]})\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[7]}\",\"unitTests\":[],\"matchMode\":\"regex\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"({drags_a[7]}|{drags_a[6]})\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":\"0px\",\"customMarkingAlgorithm\":\"\",\"showCorrectAnswer\":true,\"extendBaseMarkingAlgorithm\":true,\"variableReplacementStrategy\":\"originalfirst\"},{\"displayAnswer\":\"{drags_a[8]}\",\"unitTests\":[],\"matchMode\":\"exact\",\"showFeedbackIcon\":true,\"type\":\"patternmatch\",\"fixedWidth\":\"0px\",\"answer\":\"{drags_a[8]}\",\"marks\":\"0\",\"scripts\":{},\"variableReplacements\":[],\"fixedHeight\":