// Numbas version: finer_feedback_settings
{"name": "Daniel's drag and drop test", "extensions": ["scholar-drag-1-to-1"], "custom_part_types": [{"source": {"pk": 291, "author": {"name": "Scholar Team", "pk": 31784}, "edit_page": "/part_type/291/edit"}, "name": "Scholar drag and drop text 1 to 1 (for team testing)", "short_name": "drag-and-drop-text-1-to-1-1", "description": "<p>A replacement for this question type- although it may focus more on clikcing than dragging</p>", "help_url": "", "input_widget": "ScholarDAndD121", "input_options": {"correctAnswer": "settings['how_many_gaps']", "hint": {"static": false, "value": "\"Select a tile or on a space, then click a match to move it to the location. You can use tab and space bar.\""}, "target_width": {"static": false, "value": "settings['target_width']"}, "target_height": {"static": false, "value": "settings['target_height']"}, "target_text": {"static": false, "value": "settings['target_text']"}, "how_many_gaps": {"static": false, "value": "settings['how_many_gaps']"}, "distractors": {"static": false, "value": "settings['distractors']"}, "mark_on_Match": {"static": false, "value": "settings['mark_on_match']"}, "all_or_nothing": {"static": false, "value": "settings['all_or_nothing']"}}, "can_be_gap": true, "can_be_step": true, "marking_script": "mark:\nif(interpreted_answer = 0, incorrect(\"You have not found any matches. Try again?\"),\nif(interpreted_answer < input_options[\"how_many_gaps\"],if (input_options['all_or_nothing'],incorrect(\"You must find all matches to get the marks\") , apply(partialFeedback)),correct(\"Well done you matched them all.\"));end())\n\ninterpreted_answer:\nstudentAnswer\n\nmarkPerGap:\n1/input_options[\"how_many_gaps\"]\n\npartialFeedback:\nset_credit(markPerGap * interpreted_answer, \"You found some but not all of the pairs\"); end()", "marking_notes": [{"name": "mark", "description": "This is the main marking note. It should award credit and provide feedback based on the student's answer.", "definition": "if(interpreted_answer = 0, incorrect(\"You have not found any matches. Try again?\"),\nif(interpreted_answer < input_options[\"how_many_gaps\"],if (input_options['all_or_nothing'],incorrect(\"You must find all matches to get the marks\") , apply(partialFeedback)),correct(\"Well done you matched them all.\"));end())"}, {"name": "interpreted_answer", "description": "A value representing the student's answer to this part.", "definition": "studentAnswer"}, {"name": "markPerGap", "description": "", "definition": "1/input_options[\"how_many_gaps\"]"}, {"name": "partialFeedback", "description": "", "definition": "set_credit(markPerGap * interpreted_answer, \"You found some but not all of the pairs\"); end()"}], "settings": [{"name": "target_text", "label": "Paragraph(s) with fill in words", "help_url": "", "hint": "<p>Create gaps/drop zones using %[drop text]%. Any text within the %[ ]% will be turned into a drop item.</p>\n<p>For capitalisation on drop put a !^! within the drop text e.g. %[!^!capitlaise anything dropped here%]</p>\n<p>Use css styles and/or tables for layout e.g. for tables in the target_text. E.g. to change text alignment within a td use style=\"text-align:left !important\"</p>\n<p>Insert images using the insert image tool- that will bring the alt text with it</p>\n<p>Latex- to prevent the latex being selectable, wrap it in a span class=\"latex\" tag e.g. %[&lt;span class=\"latex\"&gt;$(x + 4) ^ 6$&lt;/span&gt;]%</p>", "input_type": "html", "default_value": "<p>Write some <strong>text</strong> with the %[targets]% marked up using %[percent]% and %[square bracket]%. Anything marked up like %[this]% will be replaced with a target and a clickable item that matches the drop will be created.&nbsp;</p>\n<p>You can use HTML markup in your paragraph(s) and to include images&nbsp;</p>", "subvars": true}, {"name": "how_many_gaps", "label": "How many gaps are there in the question", "help_url": "", "hint": "This setting is used for marking- the stuident must match the number of gaps you ahve put here in order to be marked correct. between 0 and this number they will get partial marks", "input_type": "code", "default_value": "5", "evaluate": true}, {"name": "distractors", "label": "Additional distractors", "help_url": "", "hint": "These are additional distractors which can be added. These drags have no 'match'. It is harder to use html here unfortunately.", "input_type": "list_of_strings", "default_value": [], "subvars": false}, {"name": "target_width", "label": "Width of the drop target", "help_url": "", "hint": "This sets the width of both the target and of the 'draggable' items", "input_type": "string", "default_value": "120", "subvars": false}, {"name": "target_height", "label": "Height of drop target", "help_url": "", "hint": "This sets the height of both the target and of the 'draggable' items", "input_type": "string", "default_value": "30", "subvars": false}, {"name": "mark_on_match", "label": "Mark each answer when it is dropped", "help_url": "", "hint": "Default value false but if this is true the tick cross will be displayed as the items are dropped", "input_type": "checkbox", "default_value": false}, {"name": "all_or_nothing", "label": "Award credit only if all correct", "help_url": "", "hint": "Default value false but if true then the student will get 0 marks for some but not all correct, and will be awarded the amount in marks when they get all correct.", "input_type": "checkbox", "default_value": false}], "public_availability": "always", "published": true, "extensions": ["scholar-drag-1-to-1"]}], "resources": [], "navigation": {"allowregen": true, "showfrontpage": false, "preventleave": false, "typeendtoleave": false}, "question_groups": [{"pickingStrategy": "all-ordered", "questions": [{"name": "Daniel's drag and drop test", "tags": [], "metadata": {"description": "", "licence": "None specified"}, "statement": "", "advice": "", "rulesets": {}, "extensions": ["scholar-drag-1-to-1"], "builtin_constants": {"e": true, "pi,\u03c0": true, "i": true, "j": false}, "constants": [], "variables": {}, "variablesTest": {"condition": "", "maxRuns": 100}, "ungrouped_variables": [], "variable_groups": [], "functions": {}, "preamble": {"js": "", "css": ""}, "parts": [{"type": "drag-and-drop-text-1-to-1-1", "useCustomName": true, "customName": "Sentence reorder as drag and drop", "marks": "13", "scripts": {}, "customMarkingAlgorithm": "", "extendBaseMarkingAlgorithm": true, "unitTests": [], "showCorrectAnswer": true, "showFeedbackIcon": true, "variableReplacements": [], "variableReplacementStrategy": "originalfirst", "nextParts": [], "suggestGoingBack": false, "adaptiveMarkingPenalty": 0, "exploreObjective": null, "settings": {"target_text": "<p>%[!^!this]%%[is]%%[essentially]%%[a]%%[sentence]%%[reorder]%%[but]%%[done]%%[as]%%[a]%%[drag]%%[and]%%[drop]%.</p>\n<p></p>", "how_many_gaps": "13", "distractors": ["test distractor", "another distractor"], "target_width": "120", "target_height": "40", "mark_on_match": false, "all_or_nothing": false}}, {"type": "drag-and-drop-text-1-to-1-1", "useCustomName": false, "customName": "", "marks": "1", "scripts": {}, "customMarkingAlgorithm": "", "extendBaseMarkingAlgorithm": true, "unitTests": [], "showCorrectAnswer": true, "showFeedbackIcon": true, "variableReplacements": [], "variableReplacementStrategy": "originalfirst", "nextParts": [], "suggestGoingBack": false, "adaptiveMarkingPenalty": 0, "exploreObjective": null, "prompt": "<p><span style=\"color: #000000; font-family: Roboto; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: #ffffff; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">Complete the equation by dragging and dropping the formulae into place.</span></p>", "settings": {"target_text": "<table>\n<tbody>\n<tr>\n<td>Adding acid</td>\n<td>H<sup>+</sup></td>\n<td>+</td>\n<td>%[NH<sub>3</sub>]%</td>\n<td>\u21cc</td>\n<td>%[NH<sub>4</sub><sup>+</sup>]%</td>\n<td></td>\n<td></td>\n</tr>\n<tr>\n<td>Adding alkali</td>\n<td>OH<sup>-</sup></td>\n<td>+</td>\n<td>%[NH<sub>4</sub><sup>+</sup>]%</td>\n<td>\u21cc</td>\n<td>%[NH<sub>3</sub>]%</td>\n<td>+</td>\n<td>%[H<sub>2</sub>O]%</td>\n</tr>\n</tbody>\n</table>", "how_many_gaps": "5", "distractors": ["H<sub>3</sub>O"], "target_width": "", "target_height": "", "mark_on_match": false, "all_or_nothing": false}}], "partsMode": "all", "maxMarks": 0, "objectives": [], "penalties": [], "objectiveVisibility": "always", "penaltyVisibility": "always", "contributors": [{"name": "Daniel Pacey", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/831/"}, {"name": "Scholar Team", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/31784/"}], "resources": []}]}], "contributors": [{"name": "Daniel Pacey", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/831/"}, {"name": "Scholar Team", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/31784/"}]}