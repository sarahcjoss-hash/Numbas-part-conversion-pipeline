{"navigation": {"showresultspage": "oncompletion", "preventleave": true, "allowregen": false, "onleave": {"action": "none", "message": ""}, "reverse": true, "showfrontpage": true, "browse": true}, "extensions": [], "showstudentname": true, "feedback": {"showactualmark": true, "intro": "", "showtotalmark": true, "feedbackmessages": [], "advicethreshold": 0, "allowrevealanswer": true, "showanswerstate": true, "enterreviewmodeimmediately": true, "showexpectedanswerswhen": "inreview", "showpartfeedbackmessageswhen": "always", "showactualmarkwhen": "always", "showtotalmarkwhen": "always", "showanswerstatewhen": "always", "showadvicewhen": "never"}, "duration": 0, "custom_part_types": [], "percentPass": 0, "question_groups": [{"questions": [{"name": "Activity based costing", "extensions": [], "custom_part_types": [], "resources": [], "navigation": {"showfrontpage": false, "preventleave": false, "allowregen": true}, "contributors": [{"name": "Oormi Khaled", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/985/"}, {"name": "Sarah Hirstwood", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/6/"}, {"name": "Mandy Tait", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/15/"}], "functions": {}, "statement": "<p>The cost pool for Purchasing amounts to &pound;{dpformat(cp,0,\"en\")}.</p>\n<p>During the period there are:</p>\n<ul>\n<li>{pr} purchase requisitions</li>\n<li>{dpformat(so,0,\"en\")} sales orders</li>\n<li>{ms} machine set-ups</li>\n</ul>", "preamble": {"css": "", "js": ""}, "advice": "", "ungrouped_variables": ["pr", "so", "ms", "cpu", "z", "zu", "cp"], "tags": ["ah_cacc2_1etq1"], "rulesets": {}, "variables": {"cpu": {"description": "", "name": "cpu", "definition": "random(20..60#20)", "templateType": "anything", "group": "Ungrouped variables"}, "so": {"description": "", "name": "so", "definition": "random(4000..12000#1000)", "templateType": "anything", "group": "Ungrouped variables"}, "pr": {"description": "", "name": "pr", "definition": "random(300..800#100)", "templateType": "anything", "group": "Ungrouped variables"}, "z": {"description": "", "name": "z", "definition": "random(20..60#20)", "templateType": "anything", "group": "Ungrouped variables"}, "ms": {"description": "", "name": "ms", "definition": "random(20..80#10)", "templateType": "anything", "group": "Ungrouped variables"}, "zu": {"description": "<p>random</p>", "name": "zu", "definition": "random(4000..20000#1000 except 5000..7000 except 9000 except 11000..19000)", "templateType": "anything", "group": "Ungrouped variables"}, "cp": {"description": "", "name": "cp", "definition": "pr*cpu", "templateType": "anything", "group": "Ungrouped variables"}}, "variablesTest": {"condition": "", "maxRuns": 100}, "metadata": {"description": "<p>ah_cacc2_1etq1</p>", "licence": "All rights reserved"}, "parts": [{"sortAnswers": false, "gaps": [{"marks": "2", "correctAnswerFraction": false, "showCorrectAnswer": true, "maxValue": "{cp / pr}", "fixedWidth": "0px", "unitTests": [], "allowFractions": false, "mustBeReduced": false, "mustBeReducedPC": 0, "variableReplacements": [], "minValue": "{cp / pr}", "extendBaseMarkingAlgorithm": true, "showFeedbackIcon": true, "correctAnswerStyle": "plain", "fixedHeight": "0px", "variableReplacementStrategy": "originalfirst", "notationStyles": ["plain", "en", "si-en"], "type": "numberentry", "scripts": {}, "customMarkingAlgorithm": ""}], "showCorrectAnswer": true, "prompt": "<p>Calculate the cost per purchase requisition.</p>\n<p>&pound; [[0]]</p>", "unitTests": [], "marks": 0, "variableReplacements": [], "extendBaseMarkingAlgorithm": true, "showFeedbackIcon": true, "variableReplacementStrategy": "originalfirst", "type": "gapfill", "scripts": {}, "customMarkingAlgorithm": ""}, {"sortAnswers": false, "marks": 0, "gaps": [{"precision": "2", "showPrecisionHint": true, "correctAnswerFraction": false, "customMarkingAlgorithm": "", "maxValue": "{precRound(cp / pr * z / zu , 2)}", "allowFractions": false, "mustBeReduced": false, "mustBeReducedPC": 0, "extendBaseMarkingAlgorithm": true, "precisionMessage": "Give your answer to 2 decimal places.", "fixedWidth": "0px", "variableReplacementStrategy": "originalfirst", "notationStyles": ["plain", "en", "si-en"], "precisionType": "dp", "scripts": {}, "precisionPartialCredit": "50", "showCorrectAnswer": true, "unitTests": [], "fixedHeight": "0px", "marks": "3", "variableReplacements": [], "showFeedbackIcon": true, "minValue": "{precRound(cp / pr * z / zu , 2)}", "strictPrecision": true, "type": "numberentry", "correctAnswerStyle": "plain"}], "showCorrectAnswer": true, "prompt": "<p>{z} of the requisitions were for product Z of which {dpformat(zu,0,\"en\")} units were made</p>\n<p>Calculate the cost per unit.</p>\n<p>&pound; [[0]]</p>", "unitTests": [], "stepsPenalty": 0, "variableReplacements": [], "extendBaseMarkingAlgorithm": true, "showFeedbackIcon": true, "variableReplacementStrategy": "originalfirst", "customMarkingAlgorithm": "", "type": "gapfill", "scripts": {}, "steps": [{"marks": 0, "variableReplacements": [], "extendBaseMarkingAlgorithm": true, "showFeedbackIcon": true, "showCorrectAnswer": true, "variableReplacementStrategy": "originalfirst", "prompt": "<p>Total cost charged is the number of requisitions times cost per requisition.</p>\n<p>Divide the total cost by the number of units to find the cost per unit.</p>", "unitTests": [], "type": "information", "scripts": {}, "customMarkingAlgorithm": ""}]}], "variable_groups": []}, {"name": "Activity based costing", "extensions": [], "custom_part_types": [], "resources": [], "navigation": {"showfrontpage": false, "preventleave": false, "allowregen": true}, "contributors": [{"name": "Oormi Khaled", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/985/"}, {"name": "Sarah Hirstwood", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/6/"}, {"name": "Mandy Tait", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/15/"}], "functions": {}, "statement": "<p>After calculation, the following costs per driver have been established for the next period.</p>\n<table>\n<tbody>\n<tr>\n<td>Machine Set-up</td>\n<td>&pound;{dpformat(ms,0,\"en\")}</td>\n</tr>\n<tr>\n<td>Despatch</td>\n<td>&pound;{d}</td>\n</tr>\n<tr>\n<td>Building Costs (heat/rent etc)</td>\n<td>&pound;{bc} per machine hour</td>\n</tr>\n</tbody>\n</table>\n<p>The following data applies to the three products manufactured by the business.</p>\n<table border=\"2\" cellpadding=\"5\">\n<tbody>\n<tr>\n<th></th>\n<th>Product 1</th>\n<th>Product 2</th>\n<th>Product 3</th>\n</tr>\n<tr>\n<td>Prime Cost</td>\n<td align=\"center\">&pound;{pc1}</td>\n<td align=\"center\">&pound;{pc2}</td>\n<td align=\"center\">&pound;{pc3}</td>\n</tr>\n<tr>\n<td>Number of units</td>\n<td align=\"center\">{dpformat(u1,0,\"en\")}</td>\n<td align=\"center\">{dpformat(u2,0,\"en\")}</td>\n<td align=\"center\">{dpformat(u3,0,\"en\")}</td>\n</tr>\n<tr>\n<td>Number of machine set-ups</td>\n<td align=\"center\">{ms1}</td>\n<td align=\"center\">{ms2}</td>\n<td align=\"center\">{ms3}</td>\n</tr>\n<tr>\n<td>Number of sales orders</td>\n<td align=\"center\">{d1}</td>\n<td align=\"center\">{d2}</td>\n<td align=\"center\">{d3}</td>\n</tr>\n<tr>\n<td>Machine hours</td>\n<td align=\"center\">{bc1}</td>\n<td align=\"center\">{bc2}</td>\n<td align=\"center\">{bc3}</td>\n</tr>\n</tbody>\n</table>", "preamble": {"css": "/* style for header row */\n#accounts-table tr th, #accounts-table-input1, #accounts-table-input2 tr th {\n  background-color: #cccccc;\n  position: center; /*left;*/\n  text-align: center;\n}\n\n/* style for row */\n#accounts-table1 tr td:nth-child(2), #accounts-table1 tr td:nth-child(3), #accounts-table1 tr td:nth-child(4), #accounts-table1 tr td:nth-child(5) , #accounts-table1 tr td:nth-child(6){\n  text-align: right;\n}\n#accounts-table2 tr td:nth-child(2), #accounts-table2 tr td:nth-child(3), #accounts-table2 tr td:nth-child(4), #accounts-table2 tr td:nth-child(5) , #accounts-table2 tr td:nth-child(6){\n  text-align: right;\n}\n\n/* style for final totals  */\n/*#accounts-table tr:last-child, #accounts-table:last-child th {\n  background-color: #cccccc;\n  font-weight: bold;\n  border-top: 2px solid;\n}*/\n\n/* style for final totals  */\n#accounts-table:last-child th {\n  background-color: #cccccc;\n  font-weight: bold;\n}\n\n\n#accounts-table-input1 tr:nth-child(2) td:nth-child(3) {\n  /*background-color: #AACCEE;*/\n}\n#accounts-table-input2 tr:nth-child(2) td:nth-child(3) {\n  /*background-color: #AACCEE;*/\n}", "js": ""}, "advice": "", "ungrouped_variables": ["ms", "d", "u1", "u2", "u3", "ms1", "ms2", "ms3", "d1", "d2", "d3", "bc", "bc1", "bc2", "bc3", "pc1", "pc2", "pc3", "scholar_reveal_a"], "tags": ["ah_cacc2_1etq2", "ah_cacc2_1etq2_tablecomplete.swf"], "rulesets": {}, "variables": {"u1": {"description": "", "name": "u1", "definition": "5000", "templateType": "number", "group": "Ungrouped variables"}, "pc1": {"description": "", "name": "pc1", "definition": "20", "templateType": "number", "group": "Ungrouped variables"}, "d1": {"description": "", "name": "d1", "definition": "500", "templateType": "number", "group": "Ungrouped variables"}, "bc3": {"description": "", "name": "bc3", "definition": "600", "templateType": "number", "group": "Ungrouped variables"}, "u2": {"description": "", "name": "u2", "definition": "30000", "templateType": "number", "group": "Ungrouped variables"}, "ms2": {"description": "", "name": "ms2", "definition": "15", "templateType": "number", "group": "Ungrouped variables"}, "bc": {"description": "", "name": "bc", "definition": "3", "templateType": "number", "group": "Ungrouped variables"}, "d3": {"description": "", "name": "d3", "definition": "80", "templateType": "number", "group": "Ungrouped variables"}, "ms": {"description": "", "name": "ms", "definition": "random(400..2000#400)", "templateType": "anything", "group": "Ungrouped variables"}, "bc2": {"description": "", "name":