BaseMarkingAlgorithm": true, "precisionMessage": "Give your answer to 2 decimal places.", "fixedWidth": "0px", "variableReplacementStrategy": "originalfirst", "notationStyles": ["plain", "en", "si-en"], "precisionType": "dp", "scripts": {}, "precisionPartialCredit": "50", "showCorrectAnswer": true, "unitTests": [], "fixedHeight": "0px", "marks": 1, "variableReplacements": [], "showFeedbackIcon": true, "minValue": "{precRound(pc3 + ms * ms3 / u3 + d * d3 / u3 + bc * bc3 / u3 , 2)}", "strictPrecision": true, "type": "numberentry", "correctAnswerStyle": "plain"}], "showCorrectAnswer": true, "prompt": "<p>Complete the table below to calculate the total cost of product 3.</p>\n<div id=\"accounts-table\">\n<table border=\"1\">\n<tbody>\n<tr>\n<th></th>\n<th>Product 1</th>\n<th>Product 2</th>\n<th>Product 3</th>\n</tr>\n<tr>\n<td>Prime cost</td>\n<td style=\"text-align: right;\">{pc1}</td>\n<td style=\"text-align: right;\">{pc2}</td>\n<td style=\"text-align: right;\">{pc3}</td>\n</tr>\n<tr>\n<td>Machine set-up</td>\n<td style=\"text-align: right;\">{ms1}</td>\n<td style=\"text-align: right;\">{ms2}</td>\n<td style=\"text-align: right;\">[[0]]</td>\n</tr>\n<tr>\n<td>Despatch</td>\n<td style=\"text-align: right;\">{d1}</td>\n<td style=\"text-align: right;\">{d2}</td>\n<td style=\"text-align: right;\">[[1]]</td>\n</tr>\n<tr>\n<td>Builing costs</td>\n<td style=\"text-align: right;\">{bc1}</td>\n<td style=\"text-align: right;\">{bc2}</td>\n<td style=\"text-align: right;\">[[2]]</td>\n</tr>\n<tr>\n<td>Total cost</td>\n<td style=\"text-align: right;\">{tc1}</td>\n<td style=\"text-align: right;\">{tc2}</td>\n<td style=\"text-align: right;\">[[3]]</td>\n</tr>\n</tbody>\n</table>\n</div>\n<p></p>", "unitTests": [], "marks": 0, "variableReplacements": [], "extendBaseMarkingAlgorithm": true, "showFeedbackIcon": true, "variableReplacementStrategy": "originalfirst", "type": "gapfill", "scripts": {}, "customMarkingAlgorithm": ""}, {"minMarks": 0, "customMarkingAlgorithm": "", "shuffleChoices": true, "extendBaseMarkingAlgorithm": true, "variableReplacementStrategy": "originalfirst", "choices": ["It has the shortest production runs.", "It has the lowest average sales order.", "It has the longest time to manufacture a unit.", "It has the lowest level of production.", "It has the lowest number of machine set ups."], "scripts": {}, "displayColumns": "1", "warningType": "none", "showCorrectAnswer": true, "prompt": "<p>Which three of the following help to explain why Product 1 has the highest cost?</p>", "displayType": "checkbox", "unitTests": [], "maxAnswers": 0, "maxMarks": 0, "marks": 0, "variableReplacements": [], "showFeedbackIcon": true, "matrix": ["1", "1", "1", "-1.5", "-1.5"], "distractors": ["", "", "", "You chose an incorrect answer.", "You chose an incorrect answer."], "minAnswers": 0, "type": "m_n_2"}], "variable_groups": []}], "name": "ah_cacc2_1et", "pickQuestions": 1, "pickingStrategy": "all-ordered"}], "showQuestionGroupNames": false, "resources": [], "contributors": [{"name": "Oormi Khaled", "profile_url": "https://numbas.mathcentre.ac.uk/accounts/profile/985/"}, {"name": "Sarah Hirstwood", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/6/"}, {"name": "Mandy Tait", "profile_url": "https://assess12test.scholar.hw.ac.uk/accounts/profile/15/"}], "metadata": {"description": "<p>ah_cacc2_1et</p>", "licence": "Creative Commons Attribution 4.0 International"}, "name": "End of Topic 1 Test: Activity Based Costing", "timing": {"timedwarning": {"action": "none", "message": ""}, "timeout": {"action": "none", "message": ""}, "allowPause": true}, "type": "exam"}